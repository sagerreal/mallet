{
  "name": "mallet",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint 'app/**/*.css'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:setup-role": "node --env-file=.env.local scripts/setup-app-role.mjs",
    "db:rls-proof": "node --env-file=.env.local scripts/rls-proof.mjs",
    "db:verify": "node --env-file=.env.local scripts/db-verify.mjs",
    "db:studio": "drizzle-kit studio",
    "seed:e2e": "node --env-file=.env.local scripts/seed-e2e.mjs",
    "test:e2e": "playwright test",
    "test:visual": "E2E_VISUAL=1 playwright test e2e/visual.spec.ts",
    "test:visual:update": "E2E_VISUAL=1 playwright test e2e/visual.spec.ts --update-snapshots",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:keyboard": "playwright test e2e/keyboard.spec.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.101.2",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.9",
    "papaparse": "^5.5.4",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.16.0",
    "stripe": "^22.3.0",
    "superjson": "^2.2.6",
    "twilio": "^6.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^29.1.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
