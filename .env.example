# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — keep out of the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres (Project Settings → Database → Connection string) ---
# Use the pooled "Transaction"/"Session" connection string for the app;
# drizzle-kit migrations can use the direct connection.
DATABASE_URL=

# --- App ---
NODE_ENV=development
