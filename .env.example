# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — keep out of the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres (Project Settings → Database → Connection string) ---
# DATABASE_URL: migrations/admin only (owner role, bypasses RLS). Never used at runtime in prod.
DATABASE_URL=
# APP_DATABASE_URL: runtime app connection. Must use the least-privilege `mallet_app` role
# with NOBYPASSRLS so Postgres enforces row-level security on every query.
APP_DATABASE_URL=

# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: baked into the client bundle at BUILD time — any change
# requires a full redeploy on Vercel (it is NOT a runtime env var).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- App ---
NODE_ENV=development

# --- Twilio A2P 10DLC ISV registration ---
TWILIO_PRIMARY_PROFILE_SID=
TWILIO_A2P_STATUS_CALLBACK_URL=

# --- Twilio voice -------------------------------------------------------------
# Outbound calling. The account pair places the phone-bridge call and verifies every
# webhook signature; without them calling self-disables.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Browser calling (Voice JS SDK). The API key SIGNS the short-lived Access Token the browser
# authenticates with, and the TwiML app is what Twilio fetches when the browser dials.
# The key MUST be a STANDARD key — Twilio cannot sign Access Tokens with a Restricted one.
# Without these three, calling falls back to ringing the caller's handset.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# Self-serve signup. UNSET (the default) = invite-only: identity.signup refuses to provision a
# fresh org for anyone without a pending org_invites row; invited staff still join. Set to 1 to
# reopen self-serve org creation — and re-enable "allow new users to sign up" in the Supabase
# dashboard at the same time (both gates must open together).
# Vapi (AI voice front desk). TWO different keys, and the difference matters:
#   VAPI_WEBHOOK_SECRET — verifies Vapi calling INTO the app. An already-wired number works with
#                         just this, which is why its absence is easy to miss.
#   VAPI_API_KEY        — lets the app call OUT to Vapi to REGISTER a newly bought number. Without
#                         it every new shop's line is bought and never connected to the assistant:
#                         the caller hears Twilio's "not configured" recording. Provisioning logs
#                         this loudly at signup time.
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

SIGNUPS_OPEN=
